{
  "name": "wechatpro",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "WeChatPro — 微信 PC 客户端插件：群聊统计 / 自动化检测 / 群聊信息管理 / AI 助手一体化引擎",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "wechatpro": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "brand",
    "config.example.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/cli.ts start --config config.json",
    "start": "node dist/cli.js start --config config.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage",
    "brand:assets": "tsx scripts/brand-assets.ts brand/logo.png",
    "verify:panel": "node scripts/verify-panel.mjs /tmp/panel.html",
    "verify:client": "node scripts/smoke-client.mjs",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "author": "科技酱 <https://docs.asoe.cn>",
  "homepage": "https://docs.asoe.cn",
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/asoe/TechSauce/WeChatPro.git"
  },
  "keywords": [
    "wechat",
    "wechat-pc",
    "plugin",
    "group-analytics",
    "moderation",
    "ai",
    "chatbot",
    "社群运营"
  ]
}
